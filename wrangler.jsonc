{
  "name": "escribania-tocagni",
  // Entrypoint unificado del adapter de Cloudflare (Astro 6+). Maneja tanto
  // `astro dev` como el deploy; NO apuntar a un archivo del build.
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-07-29",
  // Los dos hostnames son custom domains del Worker: al deployar, Cloudflare
  // crea y gestiona los registros DNS solo. Sin la entrada de `www` esa
  // peticion no encuentra origen y devuelve 522.
  // Declarar `routes` apaga workers.dev por defecto; se reactiva a mano porque
  // esa URL es la que no pasa por el CDN y sirve para verificar deploys.
  "workers_dev": true,
  "routes": [
    { "pattern": "escribaniatocagni.com", "custom_domain": true },
    { "pattern": "www.escribaniatocagni.com", "custom_domain": true }
  ],
  // El bloque `assets` ya no vive aca: con el adapter v14 lo genera el build
  // a partir del output de Astro (ver dist/server/wrangler.json).
  // Entorno interno (/admin). Base creada el 2026-10-22 en la cuenta Neo Nach.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "escribania-tocagni",
      "database_id": "a5f8b91b-a2bd-4bc6-beac-972000c27330",
      "migrations_dir": "migrations"
    }
  ],
  // Transcripción de voz (Whisper) para el dictado del panel.
  "ai": { "binding": "AI" },
  // Salida de mails (src/lib/notificar.ts). Reemplaza a una API key externa.
  "send_email": [{ "name": "EMAIL" }],
  // Cloudflare Access protege /admin: el middleware valida el JWT contra estos
  // dos valores (panel Zero Trust > Access > Applications). Vacíos = /admin
  // cerrado en producción.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "ethoslogliberty.cloudflareaccess.com",
    "ACCESS_AUD": "1f7f367023d8ce72f3a7dcc6488e701cef789bd4bb625a214d07c4c43eea903f"
  },
  "observability": {
    "enabled": true
  }
}
