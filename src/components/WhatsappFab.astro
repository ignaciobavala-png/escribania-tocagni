---
import { whatsappUrl } from '../data/contacto';
---

<a
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="wa-fab fixed bottom-5 right-5 md:bottom-7 md:right-7 z-40 inline-flex items-center justify-center w-14 h-14 md:w-[3.75rem] md:h-[3.75rem] text-white"
  aria-label="Consultar por WhatsApp"
>
  <svg class="w-7 h-7 md:w-8 md:h-8" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35z"/>
    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91C21.91 6.45 17.5 2 12.04 2zm0 18.15h-.01c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.24-8.23 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.69 8.23-8.21 8.23z"/>
  </svg>
</a>

<style>
  .wa-fab {
    background-color: var(--color-whatsapp);
    /* Sombra fria y baja: acompana al navy, no la sombra gris de un FAB generico */
    box-shadow: 0 8px 28px -8px rgb(26 41 64 / 0.55);
    transition:
      background-color 0.3s ease,
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  /* Filo dorado interno: lo ata al lenguaje del resto de la pagina */
  .wa-fab::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid rgb(255 255 255 / 0.14);
    pointer-events: none;
  }

  .wa-fab:focus-visible {
    outline: 1px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (hover: hover) and (pointer: fine) {
    .wa-fab:hover {
      background-color: var(--color-whatsapp-dark);
      transform: translateY(-2px);
      box-shadow: 0 12px 32px -8px rgb(26 41 64 / 0.65);
    }
  }

  /* Entra una sola vez, después de que la página asentó */
  .wa-fab {
    animation: wa-in 0.5s ease 0.7s both;
  }

  @keyframes wa-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-fab {
      animation: none;
      transition: none;
    }

    .wa-fab:hover {
      transform: none;
    }
  }
</style>
