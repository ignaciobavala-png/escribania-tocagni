      {/*
        La foto antes era mas alta que el copy y dejaba un hueco grande abajo a
        la izquierda. En desktop la figura se saca del flujo (absolute inset-y-0)
        y toma la altura exacta de la columna de texto; con aspect-[3/4] el ancho
        sale solo y la imagen entra entera, sin recorte. El pie (nombre y
        registro) va en la columna de texto para no tapar la foto.
      */}
      <div class="relative lg:col-span-5 lg:min-h-[420px]">
        <figure class="relative mx-auto w-full max-w-md lg:absolute lg:inset-y-0 lg:right-0 lg:mx-0 lg:w-auto lg:aspect-[3/4]">
          <img
            src="/escribana.jpg"
            alt="Inés Tocagni, escribana titular"
            width="768"
            height="1024"
            loading="lazy"
            decoding="async"
            class="w-full h-full aspect-[3/4] object-cover lg:aspect-auto"
          />
        </figure>
      </div>
    </div>
