---
const contactInfo = [
  { label: 'Direccion', value: 'Av. del Libertador 6328, Buenos Aires' },
  { label: 'Telefono', value: '+54 11 5555-1234' },
  { label: 'Email', value: 'info@escribaniatogcani.com' },
  { label: 'Horario', value: 'Lunes a Viernes de 9 a 18 hs' },
];
---

<footer id="contacto" class="bg-primary pt-16 md:pt-20 pb-5">
  <div class="mx-auto max-w-7xl px-6">
    <div class="w-16 h-px bg-accent mb-10" />

    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 mb-14">
      <div>
        <p class="text-sm tracking-[0.3em] uppercase text-white/30 mb-5 font-medium">
          Contacto
        </p>
        <h2 class="font-serif text-4xl md:text-5xl text-white leading-tight mb-6">
          Estamos para<br />ayudarte
        </h2>
        <p class="text-white/30 text-base leading-relaxed max-w-sm">
          Consultanos sin compromiso. Respondemos tus consultas con seriedad y discrecion.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 gap-8">
        {contactInfo.map((c) => (
          <div>
            <p class="text-sm tracking-[0.2em] uppercase text-accent/50 mb-1.5 font-medium">{c.label}</p>
            <p class="text-white/70 text-base break-words">{c.value}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Franja horizontal a todo el ancho: mapa fijo, no interactivo -->
  <div class="relative border-y border-white/10 bg-neutral-800">
    <div class="h-40 md:h-52 overflow-hidden">
      <iframe
        width="100%"
        height="100%"
        frameborder="0"
        scrolling="no"
        marginheight="0"
        marginwidth="0"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        src="https://maps.google.com/maps?q=-34.5537,-58.4505&amp;z=16&amp;hl=es&amp;output=embed"
        style="border:0; pointer-events: none;"
        title="Av. del Libertador 6328, CABA"
        tabindex="-1"
        aria-hidden="true"
      >
      </iframe>
    </div>

    <a
      href="https://www.google.com/maps/search/?api=1&amp;query=-34.5537,-58.4505"
      target="_blank"
      rel="noopener noreferrer"
      class="absolute bottom-4 right-4 md:bottom-5 md:right-6 inline-flex items-center gap-2 bg-primary/90 backdrop-blur-sm text-white/80 hover:text-white text-sm tracking-[0.2em] uppercase font-medium px-4 py-2.5 border border-white/15 hover:border-accent/60 transition-colors duration-300"
    >
      Ver en el mapa
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>

  <div class="mx-auto max-w-7xl px-6">
    <div class="pt-5">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
        <p class="text-white/25 text-sm tracking-wide">
          &copy; {new Date().getFullYear()} Escribania Togcani. Todos los derechos reservados.
        </p>
        <p class="text-white/15 text-sm tracking-wide">
          Matricula Profesional N° XXXX
        </p>
      </div>
    </div>
  </div>
</footer>
