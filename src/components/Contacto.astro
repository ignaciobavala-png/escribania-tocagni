---
import { phoneDisplay, whatsappUrl, email, mapsUrl } from '../data/contacto';

const contactInfo = [
  {
    label: 'Dirección',
    value: 'Av. del Libertador 6328, piso 5º of. 501 - C.A.B.A.',
    href: mapsUrl,
    external: true,
    hint: 'Cómo llegar',
    wide: true,
  },
  {
    label: 'Teléfono',
    value: phoneDisplay,
    href: whatsappUrl,
    external: true,
    hint: 'Escribinos por WhatsApp',
  },
  {
    label: 'Horario',
    value: 'Lunes a viernes | 10\u00a0a\u00a018\u00a0hs.',
  },
  {
    label: 'Email',
    value: email,
    href: `mailto:${email}`,
    wide: true,
  },
];
---

<footer id="contacto" class="bg-primary pb-5">
  {/*
    Mismo banner que el hero: reusa /hero-banner.webp como fondo del bloque de
    contacto. El degradado deja pasar los arcos pero baja a primary solido
    abajo, para que empalme con la franja del mapa.
  */}
  <div class="relative pt-16 md:pt-20">
    <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('/hero-banner.webp');" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-primary/45 via-primary/65 to-primary" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-6">
    <div class="w-16 h-px bg-accent mb-10" />

    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 mb-14">
      <div>
        <p class="text-sm tracking-[0.3em] uppercase text-white/30 mb-5 font-medium">
          Contacto
        </p>
        <h2 class="font-serif text-4xl md:text-5xl text-white leading-tight mb-6">
          Estamos para<br />ayudarte
        </h2>
        <p class="text-white/30 text-base leading-relaxed max-w-sm">
          Contanos qué necesitás. Nosotros nos ocupamos del resto.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 gap-8">
        {contactInfo.map((c) => (
          <div class:list={['min-w-0', c.wide && 'sm:col-span-2']}>
            <p class="text-sm tracking-[0.2em] uppercase text-accent/50 mb-1.5 font-medium">{c.label}</p>

            {c.href ? (
              <a
                href={c.href}
                target={c.external ? '_blank' : undefined}
                rel={c.external ? 'noopener noreferrer' : undefined}
                class="contact-link inline-block text-white/70 text-base break-words"
              >
                <span class="contact-value relative inline-block">
                  {/* Direccion y email van a fila completa (wide): en media
                      columna el email partia en dos. El corte tras la @ queda
                      solo como reserva para celulares muy angostos. */}
                  {c.value.includes('@') ? (
                    <>{c.value.split('@')[0]}@<wbr />{c.value.split('@')[1]}</>
                  ) : c.value}
                </span>
                {/* Sin hint no se emite la linea: antes caia en un "Escribinos"
                    por defecto que Ines pidio sacar del email. */}
                {c.hint && (
                  <span class="block mt-1 text-sm text-white/25 tracking-wide">{c.hint}</span>
                )}
              </a>
            ) : (
              <p class="text-white/70 text-base break-words">{c.value}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
  </div>

  {/* Franja horizontal a todo el ancho: mapa fijo, no interactivo */}
  <div class="relative border-y border-white/10 bg-neutral-800">
    <div class="h-40 md:h-52 overflow-hidden">
      <iframe
        width="100%"
        height="100%"
        frameborder="0"
        scrolling="no"
        marginheight="0"
        marginwidth="0"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        src="https://maps.google.com/maps?q=-34.5537,-58.4505&amp;z=16&amp;hl=es&amp;output=embed"
        style="border:0; pointer-events: none;"
        title="Av. del Libertador 6328, piso 5º of. 501 - C.A.B.A."
        tabindex="-1"
        aria-hidden="true"
      >
      </iframe>
    </div>

    <a
      href={mapsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="absolute bottom-4 left-4 md:bottom-5 md:left-6 inline-flex items-center gap-2 bg-primary/90 backdrop-blur-sm text-white/80 hover:text-white text-sm tracking-[0.2em] uppercase font-medium px-4 py-2.5 border border-white/15 hover:border-accent/60 transition-colors duration-300"
    >
      Ver en el mapa
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>

  <div class="mx-auto max-w-7xl px-6">
    <div class="pt-5">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
        <p class="text-white/25 text-sm tracking-wide">
          &copy; {new Date().getFullYear()} Escribanía Tocagni. Todos los derechos reservados.
        </p>
        <p class="text-white/15 text-sm tracking-wide">
          Registro Notarial Nº 56 · C.A.B.A.
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Regla dorada que crece de izquierda a derecha, mismo lenguaje que el resto */
  .contact-link {
    position: relative;
    transition: color 0.3s ease;
  }

  .contact-value::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -0.125rem;
    height: 1px;
    width: 100%;
    background-color: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }

  .contact-link:focus-visible {
    outline: 1px solid var(--color-accent);
    outline-offset: 4px;
  }

  @media (hover: hover) and (pointer: fine) {
    .contact-link:hover {
      color: #fff;
    }

    .contact-link:hover .contact-value::after {
      transform: scaleX(1);
    }
  }

  /* Sin puntero no hay hover que revele el enlace: la regla queda visible al 40% */
  @media (hover: none) {
    .contact-value::after {
      transform: scaleX(1);
      opacity: 0.4;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-link,
    .contact-value::after {
      transition: none;
    }
  }
</style>
