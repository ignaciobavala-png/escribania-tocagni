---
const contactInfo = [
  {
    label: 'Direccion',
    value: 'Av. Siempreviva 742, Buenos Aires',
    icon: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z',
  },
  {
    label: 'Telefono',
    value: '+54 11 5555-1234',
    icon: 'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z',
  },
  {
    label: 'Email',
    value: 'info@escribaniatogcani.com',
    icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  },
  {
    label: 'Horario',
    value: 'Lunes a Viernes de 9:00 a 18:00 hs',
    icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
  },
];
---

<section id="contacto" class="py-24 px-4 bg-white">
  <div class="mx-auto max-w-6xl">
    <div class="text-center mb-16">
      <span class="text-accent text-sm font-medium tracking-wider uppercase">Contacto</span>
      <h2 class="font-serif text-3xl md:text-4xl text-primary mt-3 mb-4">
        Estamos para ayudarte
      </h2>
      <p class="text-neutral-500 max-w-2xl mx-auto leading-relaxed">
        Consultanos sin compromiso. Respondemos todas tus consultas con seriedad y discrecion.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        contactInfo.map((c) => (
          <div class="text-center p-6 rounded-xl bg-neutral-50 border border-neutral-100">
            <div class="w-10 h-10 mx-auto mb-4 rounded-lg bg-primary/5 flex items-center justify-center">
              <svg
                class="w-5 h-5 text-primary"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d={c.icon} />
              </svg>
            </div>
            <p class="text-xs font-medium text-neutral-400 uppercase tracking-wider mb-1">{c.label}</p>
            <p class="text-sm text-neutral-700 font-medium">{c.value}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<footer class="bg-primary-dark text-white/60 py-8 px-4">
  <div class="mx-auto max-w-6xl flex flex-col sm:flex-row items-center justify-between gap-4 text-sm">
    <p>&copy; {new Date().getFullYear()} Escribania Togcani. Todos los derechos reservados.</p>
    <p class="text-white/40">Matricula Profesional N° XXXX</p>
  </div>
</footer>
