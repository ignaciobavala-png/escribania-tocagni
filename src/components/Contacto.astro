---
const contactInfo = [
  { label: 'Direccion', value: 'Av. del Libertador 6328, Buenos Aires' },
  { label: 'Telefono', value: '+54 11 5555-1234' },
  { label: 'Email', value: 'info@escribaniatogcani.com' },
  { label: 'Horario', value: 'Lunes a Viernes de 9 a 18 hs' },
];
---

<footer id="contacto" class="bg-primary py-24 md:py-32 px-6">
  <div class="mx-auto max-w-7xl">
    <div class="w-16 h-px bg-accent mb-10" />

    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 mb-16">
      <div>
        <p class="text-xs tracking-[0.3em] uppercase text-white/30 mb-5 font-medium">
          Contacto
        </p>
        <h2 class="font-serif text-3xl md:text-4xl text-white leading-tight mb-6">
          Estamos para<br />ayudarte
        </h2>
        <p class="text-white/30 text-sm leading-relaxed max-w-sm">
          Consultanos sin compromiso. Respondemos tus consultas con seriedad y discrecion.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-8">
        {contactInfo.map((c) => (
          <div>
            <p class="text-xs tracking-[0.2em] uppercase text-accent/50 mb-1.5 font-medium">{c.label}</p>
            <p class="text-white/70 text-sm">{c.value}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="rounded overflow-hidden h-64 bg-neutral-800">
      <iframe
        width="100%"
        height="100%"
        frameborder="0"
        scrolling="no"
        marginheight="0"
        marginwidth="0"
        src="https://www.openstreetmap.org/export/embed.html?bbox=-58.453,-34.556,-58.448,-34.551&amp;layer=mapnik&amp;marker=-34.5537,-58.4505"
        style="border:0; filter: grayscale(100%) invert(0.92) hue-rotate(180deg);"
        title="Av. del Libertador 6328, CABA"
      >
      </iframe>
    </div>

    <div class="border-t border-white/8 mt-16 pt-6">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
        <p class="text-white/25 text-xs tracking-wide">
          &copy; {new Date().getFullYear()} Escribania Togcani. Todos los derechos reservados.
        </p>
        <p class="text-white/15 text-xs tracking-wide">
          Matricula Profesional N° XXXX
        </p>
      </div>
    </div>
  </div>
</footer>
