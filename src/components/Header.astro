---
const navLinks = [
  { href: '#servicios', label: 'Servicios' },
  { href: '#contacto', label: 'Contacto' },
];
---

<header class="absolute top-0 left-0 right-0 z-50">
  <nav class="mx-auto max-w-6xl px-4 py-5 flex items-center justify-between">
    <a href="/" class="font-serif text-xl text-white font-semibold tracking-tight">
      Togcani
    </a>

    <div class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-white/70 hover:text-white transition-colors text-sm font-medium"
        >
          {link.label}
        </a>
      ))}
    </div>

    <a
      href="#contacto"
      class="hidden md:inline-flex bg-accent hover:bg-accent-light text-primary-dark font-medium px-5 py-2.5 rounded-lg text-sm transition-colors duration-200"
    >
      Consultar
    </a>

    <button
      class="md:hidden text-white p-1"
      aria-label="Abrir menu"
      id="mobile-menu-btn"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>
</header>
