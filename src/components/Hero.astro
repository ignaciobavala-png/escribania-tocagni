---
import Header from './Header.astro';

const badges = [
  {
    title: 'Confianza',
    description: 'Fe publica y transparencia en cada acto notarial.',
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  },
  {
    title: 'Excelencia',
    description: 'Rigor tecnico-juridico con atencion personalizada.',
    icon: 'M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z',
  },
  {
    title: 'Trayectoria',
    description: 'Mas de dos decadas de experiencia y profesionalismo.',
    icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
  },
];
---

<section class="relative min-h-screen flex items-center bg-primary overflow-hidden">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-primary-light/20 via-primary to-primary-dark pointer-events-none" />

  <div class="absolute inset-0 opacity-[0.025] pointer-events-none" style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')" />

  <div class="relative w-full">
    <Header />

    <div class="mx-auto max-w-6xl px-4 pt-32 pb-24 md:pt-40 md:pb-32">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-full px-4 py-1.5 border border-white/10 mb-8">
          <span class="w-2 h-2 rounded-full bg-accent animate-pulse" />
          <span class="text-white/80 text-sm">Mas de 20 anos de trayectoria</span>
        </div>

        <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl text-white leading-tight mb-6">
          Escribania<br />
          <span class="text-accent">Togcani</span>
        </h1>

        <p class="text-white/70 text-lg md:text-xl max-w-xl leading-relaxed mb-10">
          Seguridad juridica y confianza en cada firma. Asesoramiento notarial integral para personas, familias y empresas.
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="#servicios"
            class="inline-flex items-center justify-center gap-2 bg-accent hover:bg-accent-light text-primary-dark font-medium px-8 py-3.5 rounded-lg transition-colors duration-200"
          >
            Nuestros servicios
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <a
            href="#contacto"
            class="inline-flex items-center justify-center gap-2 bg-white/10 hover:bg-white/15 text-white backdrop-blur-sm font-medium px-8 py-3.5 rounded-lg border border-white/10 transition-colors duration-200"
          >
            Contactanos
          </a>
        </div>
      </div>
    </div>

    <div class="mx-auto max-w-6xl px-4 pb-16 md:pb-24">
      <div class="grid sm:grid-cols-3 gap-6">
        {badges.map((b) => (
          <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-xl p-6 md:p-8">
            <div class="flex items-center gap-4 mb-3">
              <svg
                class="w-8 h-8 text-accent shrink-0"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d={b.icon} />
              </svg>
              <h3 class="font-serif text-xl text-white">{b.title}</h3>
            </div>
            <p class="text-white/60 text-sm leading-relaxed">{b.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
