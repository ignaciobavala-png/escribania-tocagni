---
import Header from './Header.astro';
---

<section class="relative min-h-[76vh] md:min-h-[80vh] flex flex-col bg-primary overflow-hidden">
  <div class="absolute inset-0 opacity-[0.04]" style="background-image:
    linear-gradient(rgba(255,255,255,.12) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.12) 1px, transparent 1px);
    background-size: 80px 80px;">
  </div>

  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_transparent_0%,_var(--color-primary-dark)_100%)]" opacity-60 />

  <div class="relative flex-1 flex flex-col">
    <Header />

    <div class="flex-1 flex items-center">
      <div class="mx-auto max-w-7xl px-6 w-full">
        <div class="max-w-4xl py-12 md:py-16 mx-auto text-center">
          <div class="w-16 h-px bg-accent mb-10 mx-auto" />

          <p class="text-white/40 text-sm md:text-base tracking-[0.3em] uppercase mb-6 font-medium">
            Escribanía
          </p>

          <h1 class="font-serif text-5xl sm:text-6xl md:text-8xl text-white leading-none tracking-tight mb-6">
            Tocagni
          </h1>

          <p class="text-white/50 text-lg md:text-xl max-w-xl mx-auto leading-relaxed mb-10 font-light">
            Seguridad jurídica y confianza en cada acto notarial. Dos décadas de excelencia al servicio de nuestros clientes.
          </p>

          <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a
              href="#servicios"
              class="inline-flex items-center justify-center gap-3 bg-accent hover:bg-accent-light text-primary-dark font-medium px-9 py-4 text-base tracking-widest uppercase transition-colors duration-300"
            >
              Nuestros servicios
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>
            <a
              href="#contacto"
              class="inline-flex items-center justify-center gap-3 text-white border border-white/15 hover:border-white/30 font-medium px-9 py-4 text-base tracking-widest uppercase transition-colors duration-300"
            >
              Contacto
            </a>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
