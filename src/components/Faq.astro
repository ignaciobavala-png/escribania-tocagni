---
// Las preguntas viven en `data/faqs.ts` porque tambien son el corpus de
// grounding del chatbot: el sitio y el asistente no pueden divergir.
import { faqs } from '../data/faqs';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<section id="preguntas" class="py-16 md:py-20 px-6">
  <div class="mx-auto max-w-7xl">
    <div class="w-16 h-px bg-accent mb-10" />

    <div class="grid lg:grid-cols-12 gap-10 lg:gap-20">
      <div class="lg:col-span-4">
        <p class="text-sm tracking-[0.3em] uppercase text-neutral-400 mb-5 font-medium">
          Preguntas Frecuentes
        </p>

        <h2 class="font-serif text-4xl md:text-5xl text-primary leading-tight mb-6">
          Antes de<br />tu consulta
        </h2>

        <p class="text-neutral-500 text-base leading-relaxed max-w-sm">
          Despejá tus dudas y ahorrá tiempo antes de comenzar tu trámite.
        </p>
      </div>

      <div class="lg:col-span-8">
        {faqs.map((f) => (
          <details name="faq" class="faq border-t border-neutral-200 last:border-b">
            <summary class="flex items-start gap-4 md:gap-6 py-5 cursor-pointer select-none">
              <span class="font-serif text-base text-accent tabular-nums pt-1">
                {f.number}
              </span>

              <span class="faq-question flex-1 font-serif text-xl md:text-2xl text-primary leading-snug">
                {f.question}
              </span>

              <span class="faq-icon mt-2" aria-hidden="true" />
            </summary>

            <div class="faq-answer pl-10 md:pl-14 pr-4 pb-6 -mt-1">
              <p class="text-neutral-500 text-base leading-relaxed max-w-2xl">
                {f.answer}
              </p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
</section>

<style>
  /* Marker nativo fuera: el indicador es .faq-icon (mismo criterio que el menú móvil) */
  .faq > summary {
    list-style: none;
  }

  .faq > summary::-webkit-details-marker {
    display: none;
  }

  .faq > summary:focus-visible {
    outline: 1px solid var(--color-accent);
    outline-offset: 4px;
  }

  /* Cruz dibujada en CSS: la barra vertical colapsa al abrir y queda el signo menos */
  .faq-icon {
    position: relative;
    flex: none;
    width: 0.875rem;
    height: 0.875rem;
  }

  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    background-color: var(--color-accent);
  }

  .faq-icon::before {
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
  }

  .faq-icon::after {
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    transition: transform 0.3s ease;
  }

  .faq[open] .faq-icon::after {
    transform: scaleY(0);
  }

  .faq-question {
    transition: color 0.3s ease;
  }

  .faq[open] .faq-question {
    color: var(--color-accent-dark);
  }

  @media (hover: hover) and (pointer: fine) {
    .faq > summary:hover .faq-question {
      color: var(--color-accent-dark);
    }
  }

  .faq[open] .faq-answer {
    animation: faq-reveal 0.35s ease both;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-0.375rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-icon::after,
    .faq-question {
      transition: none;
    }

    .faq[open] .faq-answer {
      animation: none;
    }
  }
</style>
