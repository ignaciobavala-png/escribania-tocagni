---
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
const usuario = Astro.locals.usuario;
const ruta = Astro.url.pathname.replace(/\/$/, '');

// Paths de los íconos (trazo de 1.75, viewBox 24): inline para no sumar JS ni requests.
const iconos = {
  inicio: '<path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>',
  nueva: '<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/>',
  excel: '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M4 9h16M4 15h16M10 3v18"/>',
  consultas: '<path d="M4 6h16M4 12h16M4 18h10"/>',
  turnos: '<rect x="3.5" y="5" width="17" height="15" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/>',
  vencimientos: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  salir: '<path d="M15 4h4a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-4M10 16l-4-4 4-4M6 12h10"/>',
};
// `movil: false` deja el ítem fuera de la barra inferior (entran cinco).
const nav = [
  { href: '/admin', texto: 'Inicio', icono: iconos.inicio, movil: true },
  { href: '/admin/consultas', texto: 'Consultas', icono: iconos.consultas, movil: true },
  { href: '/admin/turnos', texto: 'Turnos', icono: iconos.turnos, movil: true },
  { href: '/admin/vencimientos', texto: 'Vencimientos', icono: iconos.vencimientos, movil: true },
  { href: '/admin/nueva', texto: 'Nueva consulta', icono: iconos.nueva, movil: true },
  { href: '/admin/excel', texto: 'Excel', icono: iconos.excel, movil: false },
];
const navMovil = nav.filter((n) => n.movil);
const activa = (href: string) =>
  href === '/admin/consultas' ? ruta === href || ruta.startsWith('/admin/fichas') : ruta === href;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#1a2940" />
    {/* PWA: el manifiesto vive fuera de /admin para que Access no lo bloquee. */}
    <link rel="manifest" href="/panel.webmanifest" crossorigin="use-credentials" />
    <link rel="icon" href="/icons/panel.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/panel.svg" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Tocagni" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    {/* El panel es interno: fuera de buscadores. */}
    <meta name="robots" content="noindex,nofollow" />
    <title>{title} · Panel Tocagni</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Playfair sigue cargada: las pantallas que todavía no se rediseñaron la usan. */}
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-neutral-100 min-h-screen lg:pl-64 pb-24 lg:pb-0">
    {/* Fondo opcional (lo usa solo el Inicio): queda detrás de todo. */}
    <slot name="fondo" />
    {/* Escritorio: menú lateral fijo. */}
    <aside class="hidden lg:flex fixed inset-y-0 left-0 w-64 flex-col bg-primary text-white">
      <a href="/admin" class="px-6 pt-7 pb-8 block">
        <span class="block text-xl font-semibold tracking-tight">Tocagni</span>
        <span class="block text-sm text-white/60 mt-0.5">Panel del estudio</span>
      </a>
      <nav class="flex-1 px-3 space-y-1" aria-label="Principal">
        {nav.map((n) => (
          <a
            href={n.href}
            aria-current={activa(n.href) ? 'page' : undefined}
            class={`flex items-center gap-3 rounded-xl px-3 py-3 text-base font-medium transition-colors ${activa(n.href) ? 'bg-white/12 text-white' : 'text-white/70 hover:bg-white/8 hover:text-white'}`}
          >
            <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={n.icono} />
            {n.texto}
          </a>
        ))}
      </nav>
      <div class="px-6 py-5 border-t border-white/10 text-sm">
        {usuario && (
          <p class="text-white/70 truncate" title={usuario.email}>{usuario.email}<span class="block text-white/50">{usuario.rol}</span></p>
        )}
        {/* Cierra la sesión de Access; en local no hay Access y da 404. */}
        <a href="/cdn-cgi/access/logout" class="mt-3 inline-flex items-center gap-2 text-white/70 hover:text-white">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconos.salir} />
          Salir
        </a>
      </div>
    </aside>

    {/* Teléfono: barra superior mínima. */}
    <header class="lg:hidden bg-primary text-white pt-[env(safe-area-inset-top)]">
      <div class="px-5 py-3 flex items-center justify-between">
        <a href="/admin" class="text-lg font-semibold tracking-tight">Tocagni</a>
        <a href="/cdn-cgi/access/logout" class="text-base text-white/70 py-2">Salir</a>
      </div>
    </header>

    <main class="max-w-6xl mx-auto px-5 py-8 lg:px-10 lg:py-10">
      <slot />
    </main>

    {/* En el teléfono la navegación va abajo, al alcance del pulgar. */}
    <nav
      class="lg:hidden fixed bottom-0 inset-x-0 bg-white border-t border-neutral-200 grid grid-cols-5 pb-[env(safe-area-inset-bottom)]"
      aria-label="Principal"
    >
      {navMovil.map((n) => (
        <a
          href={n.href}
          aria-current={activa(n.href) ? 'page' : undefined}
          class={`flex flex-col items-center gap-1 py-2.5 text-[0.72rem] font-medium ${activa(n.href) ? 'text-primary' : 'text-neutral-500'}`}
        >
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={n.icono} />
          {n.texto}
        </a>
      ))}
    </nav>
    <script is:inline>
      if ('serviceWorker' in navigator) navigator.serviceWorker.register('/admin/sw.js', { scope: '/admin/' }).catch(() => {});
    </script>
  </body>
</html>
