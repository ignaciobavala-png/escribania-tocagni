---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { diasHasta, fechaCorta, fechaDeInstante, hora, hoyAR } from '../../lib/fechas';

export const prerender = false;

const hoy = hoyAR();

interface FilaTurno { id: string; inicio: string; motivo: string | null; estado: string; nombre: string | null }
interface FilaFicha { id: string; nombre: string | null; resumen: string | null }

// El día de un turno se razona en hora de Buenos Aires: `inicio` está en UTC.
const [proximos, anteriores, fichas] = await Promise.all([
  env.DB.prepare(
    `SELECT t.id, t.inicio, t.motivo, t.estado, f.nombre FROM turnos t LEFT JOIN fichas f ON f.id = t.ficha_id
     WHERE date(t.inicio, '-3 hours') >= ? AND t.estado != 'cancelado' ORDER BY t.inicio LIMIT 100`,
  ).bind(hoy).all<FilaTurno>(),
  env.DB.prepare(
    `SELECT t.id, t.inicio, t.motivo, t.estado, f.nombre FROM turnos t LEFT JOIN fichas f ON f.id = t.ficha_id
     WHERE date(t.inicio, '-3 hours') < ? OR t.estado = 'cancelado' ORDER BY t.inicio DESC LIMIT 15`,
  ).bind(hoy).all<FilaTurno>(),
  env.DB.prepare(
    `SELECT id, nombre, resumen FROM fichas WHERE estado != 'cerrada' ORDER BY creada DESC LIMIT 100`,
  ).all<FilaFicha>(),
]);

const porDia = new Map<string, FilaTurno[]>();
for (const t of proximos.results) {
  const dia = fechaDeInstante(t.inicio);
  porDia.set(dia, [...(porDia.get(dia) ?? []), t]);
}
const titulo = (dia: string) => {
  const d = diasHasta(dia);
  return d === 0 ? 'Hoy' : d === 1 ? 'Mañana' : fechaCorta(dia);
};

const ETIQUETA: Record<string, string> = { pendiente: 'Pendiente', confirmado: 'Confirmado', cancelado: 'Cancelado', realizado: 'Realizado' };
const CLASE: Record<string, string> = {
  pendiente: 'bg-amber-100 text-amber-900',
  confirmado: 'bg-emerald-100 text-emerald-900',
  cancelado: 'bg-neutral-200 text-neutral-600',
  realizado: 'bg-primary/10 text-primary',
};
// Qué botones ofrece cada estado.
const ACCIONES: Record<string, { a: string; texto: string }[]> = {
  pendiente: [{ a: 'confirmado', texto: 'Confirmar' }, { a: 'cancelado', texto: 'Cancelar' }],
  confirmado: [{ a: 'realizado', texto: 'Realizado' }, { a: 'cancelado', texto: 'Cancelar' }],
  realizado: [],
  cancelado: [{ a: 'pendiente', texto: 'Reabrir' }],
};

const tarjeta = 'bg-white rounded-3xl border border-neutral-200 shadow-sm';
const campo = 'mt-1.5 w-full rounded-2xl border border-neutral-300 bg-neutral-50 px-4 py-3 text-base outline-none focus:ring-2 focus:ring-accent/50';
const etiqueta = 'text-sm font-medium text-neutral-700';
const boton = 'rounded-full border border-neutral-300 px-3.5 py-1.5 text-sm font-medium text-neutral-700 hover:bg-neutral-100 transition-colors';
---

<AdminLayout title="Turnos">
  <header class="mb-7">
    <h1 class="text-3xl md:text-4xl font-semibold tracking-tight text-primary">Turnos</h1>
    <p class="mt-2 text-lg text-neutral-600">Agendá reuniones y firmas, y seguí su estado.</p>
  </header>

  <div class="grid gap-6 lg:grid-cols-5">
    <section aria-labelledby="h-nuevo" class={`${tarjeta} lg:col-span-2 p-5 md:p-7 self-start`}>
      <h2 id="h-nuevo" class="text-xl font-semibold text-primary">Nuevo turno</h2>
      <form id="form" class="mt-4 space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <label class="block"><span class={etiqueta}>Fecha</span>
            <input type="date" name="fecha" value={hoy} min={hoy} required class={campo} /></label>
          <label class="block"><span class={etiqueta}>Hora</span>
            <input type="time" name="hora" step="900" value="10:00" required class={campo} /></label>
        </div>
        <label class="block"><span class={etiqueta}>Motivo</span>
          <input name="motivo" maxlength="160" placeholder="Ej.: firma de escritura" autocomplete="off" class={campo} /></label>
        <label class="block"><span class={etiqueta}>Consulta (opcional)</span>
          <select name="ficha_id" class={campo}>
            <option value="">Sin consulta asociada</option>
            {fichas.results.map((f) => (
              <option value={f.id}>{f.nombre ?? 'Sin nombre'}{f.resumen ? ` — ${f.resumen.slice(0, 40)}` : ''}</option>
            ))}
          </select></label>
        <button type="submit" id="guardar" class="w-full rounded-2xl bg-primary text-white py-3.5 text-base font-medium hover:bg-primary-light transition-colors disabled:opacity-50">Agendar turno</button>
        <p id="error" role="alert" class="text-base text-red-700 min-h-6"></p>
      </form>
    </section>

    <div class="lg:col-span-3 space-y-6">
      <section aria-labelledby="h-prox" class={`${tarjeta} p-5 md:p-7`}>
        <h2 id="h-prox" class="text-xl font-semibold text-primary">Próximos</h2>
        {proximos.results.length === 0 ? (
          <div class="mt-4 rounded-2xl bg-neutral-50 border border-dashed border-neutral-300 p-6 text-center">
            <p class="text-lg font-medium text-primary">No hay turnos agendados</p>
            <p class="mt-1 text-base text-neutral-600">Cuando agendes uno, aparece acá y en el Inicio el día que corresponda.</p>
          </div>
        ) : (
          <div class="mt-3 space-y-5">
            {[...porDia].map(([dia, lista]) => (
              <div>
                <h3 class="text-sm uppercase tracking-[0.2em] text-neutral-500">{titulo(dia)}</h3>
                <ul class="mt-1 divide-y divide-neutral-200">
                  {lista.map((t) => (
                    <li class="py-3 flex flex-wrap items-center gap-x-4 gap-y-2">
                      <span class="w-14 text-lg font-semibold text-primary tabular-nums">{hora(t.inicio)}</span>
                      <span class="flex-1 min-w-40 text-lg">{t.motivo ?? t.nombre ?? 'Turno'}{t.motivo && t.nombre ? <span class="text-neutral-600"> · {t.nombre}</span> : ''}</span>
                      <span class={`rounded-full px-2.5 py-0.5 text-sm ${CLASE[t.estado]}`}>{ETIQUETA[t.estado]}</span>
                      <span class="flex gap-2">
                        {ACCIONES[t.estado].map((x) => (
                          <button type="button" data-turno={t.id} data-a={x.a} class={boton}>{x.texto}</button>
                        ))}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )}
      </section>

      {anteriores.results.length > 0 && (
        <section aria-labelledby="h-ant" class={`${tarjeta} p-5 md:p-7`}>
          <h2 id="h-ant" class="text-xl font-semibold text-primary">Anteriores y cancelados</h2>
          <ul class="mt-2 divide-y divide-neutral-200">
            {anteriores.results.map((t) => (
              <li class="py-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-neutral-600">
                <span class="w-28 tabular-nums">{fechaCorta(fechaDeInstante(t.inicio))} · {hora(t.inicio)}</span>
                <span class="flex-1 min-w-40 text-base">{t.motivo ?? t.nombre ?? 'Turno'}</span>
                <span class={`rounded-full px-2.5 py-0.5 text-sm ${CLASE[t.estado]}`}>{ETIQUETA[t.estado]}</span>
                {ACCIONES[t.estado].length > 0 && t.estado === 'cancelado' && (
                  <button type="button" data-turno={t.id} data-a="pendiente" class={boton}>Reabrir</button>
                )}
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </div>

  <script is:inline>
    (() => {
      const form = document.getElementById('form');
      const error = document.getElementById('error');
      const guardar = document.getElementById('guardar');
      const enviar = async (url, metodo, cuerpo) => {
        const r = await fetch(url, { method: metodo, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(cuerpo) });
        if (!r.ok) throw new Error((await r.json().catch(() => ({}))).error || 'No se pudo guardar.');
      };
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        error.textContent = '';
        guardar.disabled = true;
        try {
          await enviar('/api/admin/turnos', 'POST', Object.fromEntries(new FormData(form)));
          location.reload();
        } catch (err) {
          error.textContent = err.message;
          guardar.disabled = false;
        }
      });
      for (const b of document.querySelectorAll('[data-turno]')) {
        b.addEventListener('click', async () => {
          b.disabled = true;
          try {
            await enviar(`/api/admin/turnos/${b.dataset.turno}`, 'PATCH', { estado: b.dataset.a });
            location.reload();
          } catch (err) {
            b.disabled = false;
            error.textContent = err.message;
          }
        });
      }
    })();
  </script>
</AdminLayout>
