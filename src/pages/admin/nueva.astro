---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { ACCEPT } from '../../lib/documentos';

export const prerender = false;

const campo = 'mt-2 w-full border border-neutral-300 bg-white px-4 py-3 text-lg';
const etiqueta = 'text-base uppercase tracking-[0.2em] text-neutral-600';
---

<AdminLayout title="Nueva consulta">
  <h1 class="font-serif text-3xl md:text-4xl text-primary tracking-tight">Nueva consulta</h1>
  <div class="w-16 h-px bg-accent mt-4 mb-8"></div>

  <form id="form" class="max-w-xl space-y-6">
    {/* El dictado va primero: es lo que se usa desde el teléfono, en la calle. */}
    <div>
      <button
        type="button"
        id="mic"
        aria-pressed="false"
        class="w-full min-h-24 bg-primary text-white text-xl font-medium flex items-center justify-center gap-4 border-2 border-primary aria-pressed:bg-red-700 aria-pressed:border-red-700 disabled:opacity-60"
      >
        <span id="mic-punto" class="w-4 h-4 rounded-full bg-accent-light" aria-hidden="true"></span>
        <span id="mic-texto">Dictar la consulta</span>
        <span id="mic-tiempo" class="tabular-nums text-white/80 hidden"></span>
      </button>
      <p id="estado" role="status" class="mt-3 text-lg text-neutral-700 min-h-7">
        Tocá, hablá y tocá de nuevo para terminar.
      </p>
    </div>

    <label class="block"><span class={etiqueta}>Detalle</span>
      <textarea name="resumen" rows="6" class={campo}></textarea></label>
    <label class="block"><span class={etiqueta}>Nombre</span>
      <input name="nombre" autocomplete="off" class={campo} /></label>
    <label class="block"><span class={etiqueta}>Teléfono o mail</span>
      <input name="contacto" autocomplete="off" autocapitalize="off" class={campo} /></label>

    <div>
      <span class={etiqueta}>Archivos (opcional)</span>
      <label for="archivos" class="mt-2 flex cursor-pointer flex-col items-center justify-center gap-1 border-2 border-dashed border-neutral-300 bg-white px-4 py-6 text-center hover:border-primary">
        <span class="text-lg font-medium text-primary">Elegir archivos o sacar una foto</span>
        <span class="text-base text-neutral-600">PDF, fotos, Word o Excel · hasta 10 MB cada uno</span>
      </label>
      <input id="archivos" type="file" multiple accept={ACCEPT} class="sr-only" />
      <ul id="lista-archivos" class="mt-2 divide-y divide-neutral-200"></ul>
    </div>

    <button type="submit" id="guardar" class="w-full bg-primary text-white py-4 text-lg font-medium disabled:opacity-50">Guardar</button>
    <p id="error" role="alert" class="text-lg text-red-700 min-h-7"></p>
  </form>
</AdminLayout>

<script>
  import { MAX_BYTES, TIPOS, extension, tamano } from '../../lib/documentos';

  const MAX_SEG = 180; // tope de grabación; el endpoint también limita el tamaño

  const form = document.querySelector<HTMLFormElement>('#form')!;
  const mic = document.querySelector<HTMLButtonElement>('#mic')!;
  const micTexto = document.querySelector<HTMLElement>('#mic-texto')!;
  const micTiempo = document.querySelector<HTMLElement>('#mic-tiempo')!;
  const micPunto = document.querySelector<HTMLElement>('#mic-punto')!;
  const estado = document.querySelector<HTMLElement>('#estado')!;
  const error = document.querySelector<HTMLElement>('#error')!;
  const guardar = document.querySelector<HTMLButtonElement>('#guardar')!;
  const detalle = form.elements.namedItem('resumen') as HTMLTextAreaElement;

  let grabador: MediaRecorder | null = null;
  let trozos: Blob[] = [];
  let reloj: number | undefined;

  const mmss = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;

  function reposo() {
    clearInterval(reloj);
    mic.setAttribute('aria-pressed', 'false');
    micTexto.textContent = 'Dictar la consulta';
    micTiempo.classList.add('hidden');
    micPunto.classList.remove('motion-safe:animate-pulse');
  }

  mic.addEventListener('click', async () => {
    if (grabador?.state === 'recording') {
      grabador.stop();
      return;
    }
    error.textContent = '';
    if (!navigator.mediaDevices?.getUserMedia || typeof MediaRecorder === 'undefined') {
      error.textContent = 'Este navegador no permite grabar audio. Escribí el detalle a mano.';
      return;
    }
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      trozos = [];
      const rec = (grabador = new MediaRecorder(stream));
      rec.ondataavailable = (e) => e.data.size && trozos.push(e.data);
      rec.onstop = async () => {
        stream.getTracks().forEach((t) => t.stop());
        reposo();
        navigator.vibrate?.(30);
        mic.disabled = true;
        estado.textContent = 'Transcribiendo…';
        try {
          const res = await fetch('/api/admin/dictar', {
            method: 'POST',
            body: new Blob(trozos, { type: rec.mimeType || 'audio/webm' }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error);
          if (!data.texto) {
            estado.textContent = 'No se escuchó nada. Probá de nuevo, más cerca del micrófono.';
          } else {
            detalle.value = [detalle.value.trim(), data.texto].filter(Boolean).join(' ');
            estado.textContent = 'Listo. Revisá el texto antes de guardar.';
          }
        } catch (e) {
          estado.textContent = '';
          error.textContent = e instanceof Error && e.message ? e.message : 'No se pudo transcribir.';
        } finally {
          mic.disabled = false;
        }
      };
      rec.start();
      navigator.vibrate?.(30);
      mic.setAttribute('aria-pressed', 'true');
      micTexto.textContent = 'Grabando · tocá para terminar';
      micTiempo.classList.remove('hidden');
      micPunto.classList.add('motion-safe:animate-pulse');
      estado.textContent = '';
      let seg = 0;
      micTiempo.textContent = mmss(0);
      reloj = window.setInterval(() => {
        micTiempo.textContent = mmss(++seg);
        if (seg >= MAX_SEG) rec.stop();
      }, 1000);
    } catch {
      error.textContent = 'No hay permiso para usar el micrófono. Habilitalo en los ajustes del navegador.';
    }
  });

  // Archivos elegidos: se suben después de crear la consulta, de a uno.
  const selector = document.querySelector<HTMLInputElement>('#archivos')!;
  const listaArchivos = document.querySelector<HTMLElement>('#lista-archivos')!;
  let archivos: File[] = [];

  function pintarArchivos() {
    listaArchivos.replaceChildren(
      ...archivos.map((f, i) => {
        const li = document.createElement('li');
        li.className = 'flex items-center gap-3 py-2 text-lg';
        const nombre = document.createElement('span');
        nombre.className = 'flex-1 truncate';
        nombre.textContent = f.name;
        const peso = document.createElement('span');
        peso.className = 'text-base text-neutral-600 shrink-0';
        peso.textContent = tamano(f.size);
        const quitar = document.createElement('button');
        quitar.type = 'button';
        quitar.className = 'min-h-12 px-3 text-base text-red-700 underline';
        quitar.textContent = 'Quitar';
        quitar.addEventListener('click', () => {
          archivos.splice(i, 1);
          pintarArchivos();
        });
        li.append(nombre, peso, quitar);
        return li;
      }),
    );
  }

  selector.addEventListener('change', () => {
    error.textContent = '';
    const rechazados: string[] = [];
    for (const f of selector.files ?? []) {
      if (!(extension(f.name) in TIPOS)) rechazados.push(`${f.name}: tipo no permitido`);
      else if (f.size > MAX_BYTES) rechazados.push(`${f.name}: supera los 10 MB`);
      else if (!archivos.some((a) => a.name === f.name && a.size === f.size)) archivos.push(f);
    }
    selector.value = '';
    if (rechazados.length) error.textContent = rechazados.join(' · ');
    pintarArchivos();
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    error.textContent = '';
    guardar.disabled = true;
    guardar.textContent = 'Guardando…';
    const res = await fetch('/api/admin/fichas', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(Object.fromEntries(new FormData(form))),
    }).catch(() => null);
    if (!res?.ok) {
      error.textContent = (await res?.json().catch(() => ({})))?.error ?? 'No se pudo guardar. Revisá la conexión.';
      guardar.disabled = false;
      guardar.textContent = 'Guardar';
      return;
    }
    const { id } = await res.json();
    let fallaron = 0;
    for (const [i, f] of archivos.entries()) {
      guardar.textContent = `Subiendo archivos (${i + 1}/${archivos.length})…`;
      const datos = new FormData();
      datos.append('archivo', f);
      const subida = await fetch(`/api/admin/fichas/${id}/documentos`, { method: 'POST', body: datos }).catch(() => null);
      if (!subida?.ok) fallaron++;
    }
    // La consulta ya existe: se va a su ficha aunque algún archivo haya fallado, y ahí se avisa.
    location.href = `/admin/fichas/${id}?nueva=1${fallaron ? `&fallaron=${fallaron}` : ''}`;
  });
</script>
