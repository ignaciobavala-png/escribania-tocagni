---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { ESTADOS, URGENCIAS, claseEstado, serviciosOpciones, type Estado } from '../../../lib/fichas';
import { fechaCorta, haceCuanto, semaforo } from '../../../lib/fechas';
import { ACCEPT, VISIBLES, tamano } from '../../../lib/documentos';

export const prerender = false;

const { id } = Astro.params;
const ficha = await env.DB.prepare('SELECT * FROM fichas WHERE id = ?').bind(id).first<{
  id: string; creada: string; nombre: string | null; contacto: string | null; servicio: string | null;
  urgencia: keyof typeof URGENCIAS; estado: Estado; resumen: string | null; origen: string;
}>();
if (!ficha) return new Response('No existe la consulta', { status: 404 });

const vencimientos = await env.DB.prepare(
  `SELECT id, concepto, vence, estado FROM vencimientos WHERE ficha_id = ? ORDER BY estado, vence`,
).bind(id).all<{ id: string; concepto: string; vence: string; estado: 'abierto' | 'resuelto' }>();

const documentos = await env.DB.prepare(
  `SELECT id, tipo, nombre, bytes, subido FROM documentos WHERE ficha_id = ? ORDER BY subido DESC`,
).bind(id).all<{ id: string; tipo: string; nombre: string; bytes: number | null; subido: string }>();

const guardada = Astro.url.searchParams.has('nueva');
const fallaron = Number(Astro.url.searchParams.get('fallaron')) || 0;
const campo = 'mt-2 w-full border border-neutral-300 bg-white px-4 py-3 text-lg';
const etiqueta = 'text-base uppercase tracking-[0.2em] text-neutral-600';

// Atajos para llamar o escribir sin copiar el dato a mano (útil desde el teléfono).
const contacto = ficha.contacto ?? '';
const enlaceContacto = contacto.includes('@')
  ? `mailto:${contacto}`
  : /\d{6,}/.test(contacto) ? `tel:${contacto.replace(/[^\d+]/g, '')}` : null;
---

<AdminLayout title={ficha.nombre ?? 'Consulta'}>
  <a href="/admin" class="text-base text-neutral-600 underline">← Volver</a>

  {guardada && (
    <p role="status" class="mt-4 border-l-4 border-emerald-600 bg-emerald-50 px-4 py-3 text-lg text-emerald-900">
      Consulta guardada.
    </p>
  )}

  {fallaron > 0 && (
    <p role="alert" class="mt-4 border-l-4 border-red-600 bg-red-50 px-4 py-3 text-lg text-red-900">
      {fallaron === 1 ? 'No se pudo subir 1 archivo.' : `No se pudieron subir ${fallaron} archivos.`} Volvé a intentarlo desde Documentos.
    </p>
  )}

  <div class="mt-4 flex flex-wrap items-center gap-3">
    <h1 class="font-serif text-3xl md:text-4xl text-primary tracking-tight">{ficha.nombre ?? 'Sin nombre'}</h1>
    <span id="estado-actual" class={`px-2 py-0.5 text-sm ${claseEstado[ficha.estado]}`}>{ESTADOS[ficha.estado]}</span>
  </div>
  <p class="text-base text-neutral-600 mt-2">
    Ingresó {haceCuanto(ficha.creada)} · {ficha.origen === 'chat' ? 'desde el chat de la web' : 'carga manual'}
  </p>
  <div class="w-16 h-px bg-accent mt-4 mb-8"></div>

  {enlaceContacto && (
    <a href={enlaceContacto} class="inline-block mb-8 bg-primary text-white px-6 py-4 text-lg font-medium w-full sm:w-auto text-center">
      {enlaceContacto.startsWith('tel:') ? 'Llamar' : 'Escribir'} · {contacto}
    </a>
  )}

  <div class="grid gap-12 lg:grid-cols-2">
    <form id="form" data-id={ficha.id} class="space-y-5">
      <label class="block"><span class={etiqueta}>Estado</span>
        <select name="estado" class={campo}>
          {Object.entries(ESTADOS).map(([v, t]) => <option value={v} selected={v === ficha.estado}>{t}</option>)}
        </select>
      </label>
      <label class="block"><span class={etiqueta}>Urgencia</span>
        <select name="urgencia" class={campo}>
          {Object.entries(URGENCIAS).map(([v, t]) => <option value={v} selected={v === ficha.urgencia}>{t}</option>)}
        </select>
      </label>
      <label class="block"><span class={etiqueta}>Tipo de trámite</span>
        <select name="servicio" class={campo}>
          <option value="">Sin definir</option>
          {serviciosOpciones.map((o) => <option value={o.valor} selected={o.valor === ficha.servicio}>{o.texto}</option>)}
        </select>
      </label>
      <label class="block"><span class={etiqueta}>Nombre</span>
        <input name="nombre" value={ficha.nombre ?? ''} autocomplete="off" class={campo} /></label>
      <label class="block"><span class={etiqueta}>Teléfono o mail</span>
        <input name="contacto" value={ficha.contacto ?? ''} autocomplete="off" autocapitalize="off" class={campo} /></label>
      <label class="block"><span class={etiqueta}>Detalle</span>
        <textarea name="resumen" rows="6" class={campo}>{ficha.resumen ?? ''}</textarea></label>
      <button type="submit" id="guardar" class="w-full bg-primary text-white py-4 text-lg font-medium disabled:opacity-50">Guardar cambios</button>
      <p id="msg" role="status" class="text-lg text-neutral-700 min-h-7"></p>
    </form>

    <section aria-labelledby="h-venc">
      <h2 id="h-venc" class="text-base uppercase tracking-[0.25em] text-neutral-600 mb-3">Vencimientos de este trámite</h2>
      {vencimientos.results.length === 0 ? (
        <p class="text-lg text-neutral-600 mb-6">Ninguno cargado.</p>
      ) : (
        <ul class="divide-y divide-neutral-200 border-y border-neutral-200 mb-6">
          {vencimientos.results.map((v) => {
            const s = semaforo(v.vence);
            const resuelto = v.estado === 'resuelto';
            return (
              <li class="py-3 flex items-center gap-3 text-lg">
                <span class={`w-3 h-3 shrink-0 rounded-full ${resuelto ? 'bg-neutral-400' : s.punto}`} aria-hidden="true"></span>
                <span class={`flex-1 ${resuelto ? 'line-through text-neutral-500' : ''}`}>
                  {v.concepto}
                  <span class="block text-base text-neutral-600">{fechaCorta(v.vence)} · {resuelto ? 'resuelto' : s.texto}</span>
                </span>
                <button type="button" data-venc={v.id} data-a={resuelto ? 'abierto' : 'resuelto'}
                  class="venc-btn border border-primary text-primary px-4 py-3 text-base min-h-12">
                  {resuelto ? 'Reabrir' : 'Resuelto'}
                </button>
              </li>
            );
          })}
        </ul>
      )}

      <form id="form-venc" class="space-y-4 border border-neutral-200 bg-white p-4">
        <p class={etiqueta}>Agregar vencimiento</p>
        <input name="concepto" placeholder="Ej.: certificado registral" autocomplete="off" required class={campo} />
        <input name="vence" type="date" required class={campo} />
        <button type="submit" class="w-full border border-primary text-primary py-4 text-lg font-medium disabled:opacity-50">Agregar</button>
        <p id="msg-venc" role="status" class="text-lg text-neutral-700 min-h-7"></p>
      </form>
    </section>
  </div>

  <section aria-labelledby="h-docs" class="mt-12">
    <h2 id="h-docs" class="text-base uppercase tracking-[0.25em] text-neutral-600 mb-3">Documentos</h2>
    {documentos.results.length === 0 ? (
      <p class="text-lg text-neutral-600 mb-4">Ningún archivo adjunto.</p>
    ) : (
      <ul class="divide-y divide-neutral-200 border-y border-neutral-200 mb-4">
        {documentos.results.map((d) => (
          <li class="py-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-lg">
            <span class="flex-1 min-w-48 break-words">
              {d.nombre}
              <span class="block text-base text-neutral-600">{tamano(d.bytes ?? 0)} · {haceCuanto(d.subido)}</span>
            </span>
            <span class="flex gap-3 text-base">
              {VISIBLES.has(d.tipo) && (
                <a href={`/api/admin/documentos/${d.id}?ver=1`} target="_blank" rel="noopener" class="min-h-12 inline-flex items-center border border-primary text-primary px-4">Ver</a>
              )}
              <a href={`/api/admin/documentos/${d.id}`} class="min-h-12 inline-flex items-center border border-primary text-primary px-4">Descargar</a>
            </span>
          </li>
        ))}
      </ul>
    )}
    <label for="subir" class="inline-flex min-h-12 cursor-pointer items-center border border-primary text-primary px-5 py-3 text-lg font-medium">Agregar archivos</label>
    <input id="subir" type="file" multiple accept={ACCEPT} class="sr-only" />
    <span class="ml-3 text-base text-neutral-600">PDF, fotos, Word o Excel · hasta 10 MB cada uno</span>
    <p id="msg-docs" role="status" class="mt-2 text-lg text-neutral-700 min-h-7"></p>
  </section>
</AdminLayout>

<script>
  import { MAX_BYTES, TIPOS, extension } from '../../../lib/documentos';

  const form = document.querySelector<HTMLFormElement>('#form')!;
  const msg = document.querySelector<HTMLElement>('#msg')!;
  const guardar = document.querySelector<HTMLButtonElement>('#guardar')!;

  async function enviar(url: string, metodo: string, datos: unknown) {
    const res = await fetch(url, { method: metodo, headers: { 'content-type': 'application/json' }, body: JSON.stringify(datos) });
    if (!res.ok) throw new Error((await res.json().catch(() => ({}))).error ?? 'No se pudo guardar.');
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    guardar.disabled = true;
    msg.textContent = 'Guardando…';
    try {
      await enviar(`/api/admin/fichas/${form.dataset.id}`, 'PATCH', Object.fromEntries(new FormData(form)));
      // Se recarga para que la etiqueta de estado y el resto reflejen lo guardado.
      location.href = location.pathname;
    } catch (err) {
      msg.textContent = err instanceof Error ? err.message : 'No se pudo guardar.';
      guardar.disabled = false;
    }
  });

  const formVenc = document.querySelector<HTMLFormElement>('#form-venc')!;
  const msgVenc = document.querySelector<HTMLElement>('#msg-venc')!;
  formVenc.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = formVenc.querySelector('button')!;
    btn.disabled = true;
    try {
      await enviar('/api/admin/vencimientos', 'POST', { ...Object.fromEntries(new FormData(formVenc)), ficha_id: form.dataset.id });
      location.reload();
    } catch (err) {
      msgVenc.textContent = err instanceof Error ? err.message : 'No se pudo agregar.';
      btn.disabled = false;
    }
  });

  document.querySelectorAll<HTMLButtonElement>('.venc-btn').forEach((b) =>
    b.addEventListener('click', async () => {
      b.disabled = true;
      try {
        await enviar(`/api/admin/vencimientos/${b.dataset.venc}`, 'PATCH', { estado: b.dataset.a });
        location.reload();
      } catch {
        b.disabled = false;
      }
    }),
  );
  // Subir documentos a esta consulta: de a uno, para saber cuál falló.
  const subir = document.querySelector<HTMLInputElement>('#subir')!;
  const msgDocs = document.querySelector<HTMLElement>('#msg-docs')!;
  subir.addEventListener('change', async () => {
    const archivos = [...(subir.files ?? [])];
    subir.value = '';
    const errores: string[] = [];
    let subidos = 0;
    for (const [i, f] of archivos.entries()) {
      if (!(extension(f.name) in TIPOS)) { errores.push(`${f.name}: tipo no permitido`); continue; }
      if (f.size > MAX_BYTES) { errores.push(`${f.name}: supera los 10 MB`); continue; }
      msgDocs.textContent = `Subiendo ${i + 1} de ${archivos.length}…`;
      const datos = new FormData();
      datos.append('archivo', f);
      const res = await fetch(`/api/admin/fichas/${form.dataset.id}/documentos`, { method: 'POST', body: datos }).catch(() => null);
      if (res?.ok) subidos++;
      else errores.push(`${f.name}: ${(await res?.json().catch(() => ({})))?.error ?? 'no se pudo subir'}`);
    }
    if (errores.length === 0) {
      location.reload();
      return;
    }
    msgDocs.textContent = `${subidos ? `${subidos} subido(s). ` : ''}${errores.join(' · ')}`;
  });
</script>
