---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { ESTADOS, claseEstado, nombreServicio, type Estado } from '../../lib/fichas';
import { fechaCorta, haceCuanto, hora, hoyAR, semaforo } from '../../lib/fechas';

export const prerender = false;

const hoy = hoyAR();

interface FilaFicha { id: string; creada: string; nombre: string | null; servicio: string | null; urgencia: string; estado: Estado; resumen: string | null }
interface FilaVenc { id: string; concepto: string; vence: string; ficha_id: string | null }
interface FilaTurno { id: string; inicio: string; motivo: string | null; nombre: string | null }

const [fichas, vencimientos, turnos] = await Promise.all([
  env.DB.prepare(
    `SELECT id, creada, nombre, servicio, urgencia, estado, resumen FROM fichas
     WHERE estado != 'cerrada'
     ORDER BY CASE urgencia WHEN 'alta' THEN 0 WHEN 'normal' THEN 1 ELSE 2 END, creada DESC LIMIT 30`,
  ).all<FilaFicha>(),
  // Solo lo que importa ya: lo vencido y lo que vence en los próximos 30 días.
  env.DB.prepare(
    `SELECT id, concepto, vence, ficha_id FROM vencimientos
     WHERE estado = 'abierto' AND vence <= date(?, '+30 days') ORDER BY vence LIMIT 20`,
  ).bind(hoy).all<FilaVenc>(),
  env.DB.prepare(
    `SELECT t.id, t.inicio, t.motivo, f.nombre FROM turnos t LEFT JOIN fichas f ON f.id = t.ficha_id
     WHERE t.estado != 'cancelado' AND substr(t.inicio, 1, 10) = ? ORDER BY t.inicio`,
  ).bind(hoy).all<FilaTurno>(),
]);

const nuevas = fichas.results.filter((f) => f.estado === 'nueva').length;
const urgentes = vencimientos.results.filter((v) => semaforo(v.vence).nivel === 'rojo').length;
---

<AdminLayout title="Resumen">
  <h1 class="font-serif text-3xl md:text-4xl text-primary tracking-tight">Hoy</h1>
  <div class="w-16 h-px bg-accent mt-4 mb-4"></div>
  <p class="text-lg text-neutral-600 mb-8">
    {nuevas === 0 ? 'No hay consultas nuevas' : nuevas === 1 ? '1 consulta nueva' : `${nuevas} consultas nuevas`}{' '}
    · {turnos.results.length === 0 ? 'sin turnos' : turnos.results.length === 1 ? '1 turno' : `${turnos.results.length} turnos`} hoy
    {urgentes > 0 && <span class="text-red-700 font-medium"> · {urgentes === 1 ? '1 vencimiento urgente' : `${urgentes} vencimientos urgentes`}</span>}
  </p>

  <div class="grid gap-10 lg:grid-cols-2">
    <div class="space-y-10">
      <section aria-labelledby="h-turnos">
        <h2 id="h-turnos" class="text-base uppercase tracking-[0.25em] text-neutral-600 mb-3">Turnos de hoy</h2>
        {turnos.results.length === 0 ? (
          <p class="text-lg text-neutral-600">No hay turnos para hoy.</p>
        ) : (
          <ul class="divide-y divide-neutral-200 border-y border-neutral-200">
            {turnos.results.map((t) => (
              <li class="py-3 flex gap-4 text-lg">
                <span class="font-medium text-primary tabular-nums">{hora(t.inicio)}</span>
                <span class="flex-1">{t.nombre ?? t.motivo ?? 'Turno'}</span>
              </li>
            ))}
          </ul>
        )}
      </section>

      <section aria-labelledby="h-venc">
        <h2 id="h-venc" class="text-base uppercase tracking-[0.25em] text-neutral-600 mb-3">Vencimientos</h2>
        {vencimientos.results.length === 0 ? (
          <p class="text-lg text-neutral-600">Nada vence en los próximos 30 días.</p>
        ) : (
          <ul class="divide-y divide-neutral-200 border-y border-neutral-200">
            {vencimientos.results.map((v) => {
              const s = semaforo(v.vence);
              return (
                <li>
                  <a href={v.ficha_id ? `/admin/fichas/${v.ficha_id}` : '#'} class="py-3 flex items-start gap-3 text-lg min-h-14">
                    <span class={`mt-2.5 w-3 h-3 shrink-0 rounded-full ${s.punto}`} aria-hidden="true"></span>
                    <span class="flex-1">{v.concepto}</span>
                    <span class="text-right text-base shrink-0">
                      <span class={s.nivel === 'rojo' ? 'block font-medium text-red-700' : 'block text-neutral-700'}>{s.texto}</span>
                      <span class="block text-neutral-600">{fechaCorta(v.vence)}</span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        )}
      </section>
    </div>

    <section aria-labelledby="h-consultas">
      <h2 id="h-consultas" class="text-base uppercase tracking-[0.25em] text-neutral-600 mb-3">Consultas abiertas</h2>
      {fichas.results.length === 0 ? (
        <p class="text-lg text-neutral-600">Todavía no hay consultas. <a class="underline text-primary" href="/admin/nueva">Cargar una</a>.</p>
      ) : (
        <ul class="divide-y divide-neutral-200 border-y border-neutral-200">
          {fichas.results.map((f) => (
            <li>
              <a href={`/admin/fichas/${f.id}`} class="block py-3 min-h-14">
                <span class="flex items-baseline justify-between gap-3 text-lg">
                  <span class="font-medium text-neutral-800">
                    {f.urgencia === 'alta' && <span class="text-red-700" title="Urgente">● </span>}{f.nombre ?? 'Sin nombre'}
                  </span>
                  <span class="text-base text-neutral-600 shrink-0">{haceCuanto(f.creada)}</span>
                </span>
                {f.resumen && <span class="block text-base text-neutral-600 line-clamp-1">{f.resumen}</span>}
                <span class="mt-1.5 flex flex-wrap items-center gap-2 text-sm">
                  <span class={`px-2 py-0.5 ${claseEstado[f.estado]}`}>{ESTADOS[f.estado]}</span>
                  {nombreServicio(f.servicio) && <span class="text-neutral-600">{nombreServicio(f.servicio)}</span>}
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>
  </div>
</AdminLayout>
