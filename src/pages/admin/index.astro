---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { ESTADOS, claseEstado, nombreServicio, type Estado } from '../../lib/fichas';
import { fechaCorta, haceCuanto, hora, hoyAR, semaforo } from '../../lib/fechas';

export const prerender = false;

const hoy = hoyAR();

interface FilaFicha { id: string; creada: string; nombre: string | null; servicio: string | null; urgencia: string; estado: Estado; resumen: string | null; origen: string | null }
interface FilaVenc { id: string; concepto: string; vence: string; ficha_id: string | null }
interface FilaTurno { id: string; inicio: string; motivo: string | null; nombre: string | null }
interface FilaActividad { cuando: string; actor: string; accion: string; entidad: string | null; ref: string | null; detalle: string | null }

const [fichas, vencimientos, turnos, actividad, autom] = await Promise.all([
  env.DB.prepare(
    `SELECT id, creada, nombre, servicio, urgencia, estado, resumen, origen FROM fichas
     WHERE estado != 'cerrada'
     ORDER BY CASE urgencia WHEN 'alta' THEN 0 WHEN 'normal' THEN 1 ELSE 2 END, creada DESC LIMIT 30`,
  ).all<FilaFicha>(),
  // Solo lo que importa ya: lo vencido y lo que vence en los próximos 30 días.
  env.DB.prepare(
    `SELECT id, concepto, vence, ficha_id FROM vencimientos
     WHERE estado = 'abierto' AND vence <= date(?, '+30 days') ORDER BY vence LIMIT 20`,
  ).bind(hoy).all<FilaVenc>(),
  env.DB.prepare(
    `SELECT t.id, t.inicio, t.motivo, f.nombre FROM turnos t LEFT JOIN fichas f ON f.id = t.ficha_id
     WHERE t.estado != 'cancelado' AND date(t.inicio, '-3 hours') = ? ORDER BY t.inicio`,
  ).bind(hoy).all<FilaTurno>(),
  env.DB.prepare(
    `SELECT cuando, actor, accion, entidad, ref, detalle FROM auditoria
     WHERE accion != 'acceso_denegado' ORDER BY id DESC LIMIT 8`,
  ).all<FilaActividad>(),
  env.DB.prepare(
    `SELECT (SELECT count(*) FROM fichas WHERE origen = 'chat') AS chat,
            (SELECT count(*) FROM auditoria WHERE accion = 'aviso_enviado') AS avisos`,
  ).first<{ chat: number; avisos: number }>(),
]);

const nuevas = fichas.results.filter((f) => f.estado === 'nueva').length;
const enCurso = fichas.results.filter((f) => f.estado === 'en_curso').length;
const chatNuevas = fichas.results.filter((f) => f.estado === 'nueva' && f.origen === 'chat').length;
const urgentes = vencimientos.results.filter((v) => semaforo(v.vence).nivel === 'rojo').length;

// Saludo y fecha en hora de Buenos Aires (el Worker corre en UTC).
const TZ = 'America/Argentina/Buenos_Aires';
const horaAR = Number(new Intl.DateTimeFormat('en-GB', { hour: '2-digit', hour12: false, timeZone: TZ }).format(new Date()));
const saludo = horaAR < 6 ? 'Buenas noches' : horaAR < 13 ? 'Buenos días' : horaAR < 20 ? 'Buenas tardes' : 'Buenas noches';
const fechaLarga = new Intl.DateTimeFormat('es-AR', { weekday: 'long', day: 'numeric', month: 'long', timeZone: TZ }).format(new Date());

// Resumen del día: reglas sobre los datos de arriba (no llama a ningún modelo).
const plural = (n: number, uno: string, varios: string) => `${n} ${n === 1 ? uno : varios}`;
const partes: string[] = [];
if (nuevas > 0) partes.push(`${plural(nuevas, 'consulta nueva', 'consultas nuevas')}${chatNuevas > 0 ? ` (${chatNuevas} por el chat del sitio)` : ''}`);
if (urgentes > 0) partes.push(plural(urgentes, 'vencimiento urgente', 'vencimientos urgentes'));
if (turnos.results.length > 0) partes.push(plural(turnos.results.length, 'turno hoy', 'turnos hoy'));
const resumenDia = partes.length === 0
  ? 'Todo al día. Cuando llegue una consulta por el chat, la ficha se crea sola y te avisamos por mail.'
  : `Hoy tenés ${partes.join(', ').replace(/, ([^,]*)$/, ' y $1')}.`;
const prioridad =
  fichas.results.find((f) => f.urgencia === 'alta' && f.estado === 'nueva') ?? fichas.results.find((f) => f.estado === 'nueva') ?? null;
const venceYa = vencimientos.results.find((v) => semaforo(v.vence).nivel === 'rojo') ?? null;

const quien = (actor: string) => (actor.includes('@') ? actor.split('@')[0] : actor);
function describir(a: FilaActividad): { texto: string; tono: 'normal' | 'alerta' } {
  const det = a.detalle ? (JSON.parse(a.detalle) as Record<string, number>) : {};
  switch (a.accion) {
    case 'ficha_creada':
      return { texto: a.actor === 'chat-web' ? 'Consulta nueva desde el chat del sitio' : `Consulta cargada por ${quien(a.actor)}`, tono: 'normal' };
    case 'aviso_enviado':
      return { texto: 'Aviso por mail enviado al estudio', tono: 'normal' };
    case 'aviso_fallido':
      return { texto: 'No se pudo enviar el aviso por mail', tono: 'alerta' };
    case 'ficha_editada':
      return { texto: `Consulta actualizada por ${quien(a.actor)}`, tono: 'normal' };
    case 'vencimiento_creado':
      return { texto: `Vencimiento agregado por ${quien(a.actor)}`, tono: 'normal' };
    case 'importacion':
      return { texto: `Planilla importada${det.importadas != null ? ` · ${det.importadas} filas` : ''}`, tono: 'normal' };
    case 'documento_subido':
      return { texto: `Documento subido por ${quien(a.actor)}`, tono: 'normal' };
    case 'documento_visto':
      return { texto: `Documento consultado por ${quien(a.actor)}`, tono: 'normal' };
    case 'documento_movido':
      return { texto: `Documento reubicado por ${quien(a.actor)}`, tono: 'normal' };
    case 'turno_creado':
      return { texto: `Turno agendado por ${quien(a.actor)}`, tono: 'normal' };
    case 'exportacion':
      return { texto: 'Planilla exportada', tono: 'normal' };
    default:
      if (a.accion.startsWith('turno_')) return { texto: `Turno ${a.accion.slice(6)}`, tono: 'normal' };
      return { texto: a.accion.startsWith('vencimiento_') ? `Vencimiento ${a.accion.slice(12)}` : a.accion.replace(/_/g, ' '), tono: 'normal' };
  }
}

// Lo que trabaja solo: cada ítem es una feature del panel, dicha en una línea.
const automatizaciones = [
  { activa: true, titulo: 'Chat del sitio → ficha', detalle: `${plural(autom?.chat ?? 0, 'consulta ingresada', 'consultas ingresadas')} sin tipear nada` },
  { activa: true, titulo: 'Aviso por mail al estudio', detalle: `${plural(autom?.avisos ?? 0, 'aviso enviado', 'avisos enviados')} apenas llega una consulta` },
  { activa: true, titulo: 'Dictado por voz', detalle: 'Hablás y la consulta queda transcripta' },
  { activa: true, titulo: 'Excel de ida y vuelta', detalle: 'Importás tu planilla y exportás cuando quieras' },
  { activa: false, titulo: 'Resumen diario por mail', detalle: 'Lo del día en tu mail, cada mañana' },
];

const vidrio = 'glass rounded-3xl';
const filtros: { valor: 'todas' | Estado; texto: string }[] = [
  { valor: 'todas', texto: 'Todas' },
  { valor: 'nueva', texto: 'Nuevas' },
  { valor: 'en_curso', texto: 'En curso' },
  { valor: 'esperando_documentacion', texto: 'Esperando documentación' },
];
const stats = [
  { n: nuevas, t: nuevas === 1 ? 'Consulta nueva' : 'Consultas nuevas', alerta: false, icono: '<path d="M4 6h16M4 12h16M4 18h10"/>' },
  { n: enCurso, t: 'En curso', alerta: false, icono: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>' },
  { n: urgentes, t: urgentes === 1 ? 'Vencimiento urgente' : 'Vencimientos urgentes', alerta: urgentes > 0, icono: '<path d="M12 3 2.5 20h19z"/><path d="M12 10v4M12 17.5v.01"/>' },
  { n: turnos.results.length, t: turnos.results.length === 1 ? 'Turno hoy' : 'Turnos hoy', alerta: false, icono: '<rect x="3.5" y="5" width="17" height="15" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/>' },
];
---

<AdminLayout title="Inicio">
  {/* Fondo: degradado cálido con dos halos desenfocados. Solo en esta pantalla. */}
  <div slot="fondo" class="fondo" aria-hidden="true">
    <span class="halo halo-a"></span>
    <span class="halo halo-b"></span>
  </div>

  {/* Asistente: el resumen del día y la acción principal. */}
  <section aria-labelledby="h-hola" class={`${vidrio} hero rise p-6 md:p-9 mb-6`} style="--d:0ms">
    <div class="grid gap-7 md:grid-cols-[1fr_auto] md:items-center">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full bg-primary/8 px-3 py-1 text-sm font-medium text-primary">
          <span class="pulso" aria-hidden="true"></span>
          Asistente del estudio
          <span class="text-neutral-500 font-normal">· <span class="first-letter:uppercase">{fechaLarga}</span></span>
        </p>
        <h1 id="h-hola" class="mt-4 text-4xl md:text-5xl font-semibold tracking-tight text-primary">{saludo}</h1>
        <p class="mt-3 text-lg md:text-xl text-neutral-700 max-w-2xl">{resumenDia}</p>

        {(prioridad || venceYa) && (
          <div class="mt-5 flex flex-wrap gap-2.5">
            {prioridad && (
              <a href={`/admin/fichas/${prioridad.id}`} class="chip">
                <span class="text-accent-dark" aria-hidden="true">✦</span>
                Empezá por <strong class="font-semibold">{prioridad.nombre ?? 'la consulta nueva'}</strong>
                {prioridad.urgencia === 'alta' && <span class="text-red-700">· urgente</span>}
              </a>
            )}
            {venceYa && (
              <a href={venceYa.ficha_id ? `/admin/fichas/${venceYa.ficha_id}` : '#'} class="chip">
                <span class="w-2 h-2 rounded-full bg-red-600" aria-hidden="true"></span>
                {venceYa.concepto} · <span class="text-red-700 font-medium">{semaforo(venceYa.vence).texto}</span>
              </a>
            )}
          </div>
        )}
      </div>

      <a href="/admin/nueva" class="mic group" aria-label="Dictar una consulta">
        <span class="mic-anillo" aria-hidden="true"></span>
        <span class="mic-boton">
          <svg class="w-9 h-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/></svg>
        </span>
        <span class="mt-3 block text-base font-semibold text-primary">Dictar consulta</span>
        <span class="block text-sm text-neutral-600">Hablás y queda la ficha</span>
      </a>
    </div>
  </section>

  {/* Números del día. */}
  <section aria-label="Resumen" class="grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4 mb-6">
    {stats.map((s, i) => (
      <div class={`${vidrio} rise p-5`} style={`--d:${80 + i * 60}ms`}>
        <span class={`grid place-items-center w-10 h-10 rounded-2xl ${s.alerta ? 'bg-red-600/10 text-red-700' : 'bg-primary/8 text-primary'}`}>
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.icono} />
        </span>
        <p class={`mt-3 text-4xl font-semibold tabular-nums ${s.alerta ? 'text-red-700' : 'text-primary'}`} data-count={s.n}>{s.n}</p>
        <p class="mt-0.5 text-base text-neutral-600">{s.t}</p>
      </div>
    ))}
  </section>

  <div class="grid gap-5 lg:grid-cols-5">
    {/* Consultas abiertas, con búsqueda y filtro por estado (sin recargar). */}
    <section aria-labelledby="h-consultas" class={`${vidrio} rise lg:col-span-3 p-5 md:p-7`} style="--d:320ms">
      <div class="flex items-baseline justify-between gap-3">
          <h2 id="h-consultas" class="text-xl font-semibold text-primary">Consultas abiertas</h2>
          <a href="/admin/consultas" class="text-base text-primary hover:underline">Ver todas →</a>
        </div>
      {fichas.results.length === 0 ? (
        <div class="mt-4 rounded-2xl bg-white/50 border border-dashed border-neutral-300 p-6 text-center">
          <p class="text-lg font-medium text-primary">Todavía no hay consultas</p>
          <p class="mt-1 text-base text-neutral-600 max-w-md mx-auto">
            Acá van a aparecer las que lleguen por el chat del sitio (cada una te avisa por mail) y las que cargues vos.
          </p>
          <a href="/admin/nueva" class="mt-4 inline-block rounded-2xl bg-primary text-white px-5 py-3 text-base font-medium">Cargar la primera</a>
        </div>
      ) : (
        <>
          <input
            id="buscar"
            type="search"
            placeholder="Buscar por nombre o detalle"
            aria-label="Buscar consultas"
            class="mt-4 w-full rounded-2xl border border-white/70 bg-white/60 px-4 py-3 text-base outline-none focus:ring-2 focus:ring-accent/50"
          />
          <div id="filtros" class="mt-3 flex flex-wrap gap-2" role="group" aria-label="Filtrar por estado">
            {filtros.map((f, i) => (
              <button type="button" data-filtro={f.valor} aria-pressed={i === 0 ? 'true' : 'false'}
                class="rounded-full border border-neutral-300/70 bg-white/40 px-4 py-1.5 text-base text-neutral-700 aria-pressed:bg-primary aria-pressed:border-primary aria-pressed:text-white transition-colors">
                {f.texto}
              </button>
            ))}
          </div>
          <ul id="lista" class="mt-3 divide-y divide-neutral-200/70">
            {fichas.results.map((f) => (
              <li data-estado={f.estado} data-texto={`${f.nombre ?? ''} ${f.resumen ?? ''}`.toLowerCase()}>
                <a href={`/admin/fichas/${f.id}`} class="block -mx-3 px-3 py-3.5 rounded-2xl min-h-14 transition-colors hover:bg-white/60">
                  <span class="flex items-baseline justify-between gap-3 text-lg">
                    <span class="font-medium text-neutral-900">
                      {f.urgencia === 'alta' && <span class="text-red-700" title="Urgente">● </span>}{f.nombre ?? 'Sin nombre'}
                    </span>
                    <span class="text-sm text-neutral-600 shrink-0">{haceCuanto(f.creada)}</span>
                  </span>
                  {f.resumen && <span class="block text-base text-neutral-600 line-clamp-1">{f.resumen}</span>}
                  <span class="mt-1.5 flex flex-wrap items-center gap-2 text-sm">
                    <span class={`rounded-full px-2.5 py-0.5 ${claseEstado[f.estado]}`}>{ESTADOS[f.estado]}</span>
                    {f.origen === 'chat' && <span class="rounded-full px-2.5 py-0.5 bg-accent/15 text-accent-dark">✦ Desde el chat</span>}
                    {nombreServicio(f.servicio) && <span class="text-neutral-600">{nombreServicio(f.servicio)}</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <p id="sin-resultados" class="hidden mt-4 text-base text-neutral-600">Ninguna consulta coincide con la búsqueda.</p>
        </>
      )}
    </section>

    <div class="lg:col-span-2 space-y-5">
      {/* Qué hace el sistema solo: vuelve visibles las automatizaciones. */}
      <section aria-labelledby="h-auto" class={`${vidrio} rise p-5 md:p-7`} style="--d:380ms">
        <h2 id="h-auto" class="text-xl font-semibold text-primary">Trabaja por vos</h2>
        <ul class="mt-3 space-y-3.5">
          {automatizaciones.map((a) => (
            <li class="flex items-start gap-3">
              <span class={`mt-1.5 w-2.5 h-2.5 rounded-full shrink-0 ${a.activa ? 'bg-emerald-600' : 'bg-neutral-300'}`} aria-hidden="true"></span>
              <span class={a.activa ? '' : 'opacity-70'}>
                <span class="block text-base font-medium text-neutral-900">
                  {a.titulo}{!a.activa && <span class="ml-2 rounded-full bg-neutral-200/80 px-2 py-0.5 text-xs font-medium text-neutral-600 align-middle">Pronto</span>}
                </span>
                <span class="block text-sm text-neutral-600">{a.detalle}</span>
              </span>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="h-turnos" class={`${vidrio} rise p-5 md:p-7`} style="--d:440ms">
        <div class="flex items-baseline justify-between gap-3">
          <h2 id="h-turnos" class="text-xl font-semibold text-primary">Turnos de hoy</h2>
          <a href="/admin/turnos" class="text-base text-primary hover:underline">Agendar →</a>
        </div>
        {turnos.results.length === 0 ? (
          <p class="mt-3 text-base text-neutral-600">Sin turnos para hoy.</p>
        ) : (
          <ul class="mt-3 space-y-2">
            {turnos.results.map((t) => (
              <li class="flex gap-4 text-lg">
                <span class="font-semibold text-primary tabular-nums">{hora(t.inicio)}</span>
                <span class="flex-1">{t.nombre ?? t.motivo ?? 'Turno'}</span>
              </li>
            ))}
          </ul>
        )}
      </section>

      <section aria-labelledby="h-venc" class={`${vidrio} rise p-5 md:p-7`} style="--d:500ms">
        <div class="flex items-baseline justify-between gap-3">
          <h2 id="h-venc" class="text-xl font-semibold text-primary">Vencimientos</h2>
          <a href="/admin/vencimientos" class="text-base text-primary hover:underline">Ver todos →</a>
        </div>
        {vencimientos.results.length === 0 ? (
          <p class="mt-3 text-base text-neutral-600">Nada vence en los próximos 30 días. Los plazos que cargues en una consulta aparecen acá con semáforo.</p>
        ) : (
          <ul class="mt-2 divide-y divide-neutral-200/70">
            {vencimientos.results.map((v) => {
              const s = semaforo(v.vence);
              return (
                <li>
                  <a href={v.ficha_id ? `/admin/fichas/${v.ficha_id}` : '#'} class="py-3 flex items-start gap-3 text-lg min-h-14">
                    <span class={`mt-2.5 w-3 h-3 shrink-0 rounded-full ${s.punto}`} aria-hidden="true"></span>
                    <span class="flex-1">{v.concepto}</span>
                    <span class="text-right text-base shrink-0">
                      <span class={s.nivel === 'rojo' ? 'block font-medium text-red-700' : 'block text-neutral-700'}>{s.texto}</span>
                      <span class="block text-sm text-neutral-600">{fechaCorta(v.vence)}</span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        )}
      </section>

      <section aria-labelledby="h-act" class={`${vidrio} rise p-5 md:p-7`} style="--d:560ms">
        <h2 id="h-act" class="text-xl font-semibold text-primary">Actividad reciente</h2>
        {actividad.results.length === 0 ? (
          <p class="mt-3 text-base text-neutral-600">Todo lo que pase en el panel y en el chat queda registrado acá.</p>
        ) : (
          <ul class="mt-3 space-y-3">
            {actividad.results.map((a) => {
              const d = describir(a);
              const href = a.entidad === 'ficha' && a.ref ? `/admin/fichas/${a.ref}` : null;
              const contenido = (
                <>
                  <span class={`mt-2 w-2 h-2 rounded-full shrink-0 ${d.tono === 'alerta' ? 'bg-red-600' : 'bg-accent'}`} aria-hidden="true"></span>
                  <span class="flex-1 text-base">{d.texto}</span>
                  <span class="text-sm text-neutral-500 shrink-0">{haceCuanto(a.cuando)}</span>
                </>
              );
              return <li>{href ? <a href={href} class="flex items-start gap-3 hover:text-primary">{contenido}</a> : <div class="flex items-start gap-3">{contenido}</div>}</li>;
            })}
          </ul>
        )}
      </section>
    </div>
  </div>

  <style>
    /* Tarjeta del asistente: un borde de luz bronce que recorre el contorno. */
    .hero { position: relative; }
    .hero::before {
      content: '';
      position: absolute;
      inset: -1px;
      border-radius: inherit;
      padding: 1.5px;
      background: linear-gradient(120deg, transparent 30%, #c7a76a 50%, transparent 70%) 0 0 / 250% 100%;
      -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      pointer-events: none;
      animation: brillo 7s linear infinite;
    }
    @keyframes brillo {
      from { background-position: 150% 0; }
      to { background-position: -100% 0; }
    }

    /* Punto "en vivo" del asistente. */
    .pulso {
      position: relative;
      width: 0.5rem; height: 0.5rem;
      border-radius: 9999px;
      background: #1e6b4f;
    }
    .pulso::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: inherit;
      animation: onda 2.4s ease-out infinite;
    }
    @keyframes onda {
      to { transform: scale(3.2); opacity: 0; }
    }

    .chip {
      display: inline-flex; align-items: center; gap: 0.5rem;
      border-radius: 9999px;
      padding: 0.5rem 1rem;
      font-size: 1rem;
      color: #3d3830;
      background: rgb(255 255 255 / 0.7);
      border: 1px solid rgb(255 255 255 / 0.9);
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .chip:hover { transform: translateY(-1px); box-shadow: 0 6px 16px -8px rgb(26 41 64 / 0.35); }

    /* Botón del micrófono: la acción estrella, con un anillo que respira. */
    .mic { position: relative; display: grid; justify-items: center; text-align: center; }
    .mic-boton {
      position: relative; z-index: 1;
      display: grid; place-items: center;
      width: 5.5rem; height: 5.5rem;
      border-radius: 9999px;
      color: #fff;
      background: linear-gradient(145deg, #264468, #1a2940);
      box-shadow: 0 14px 30px -10px rgb(26 41 64 / 0.7), 0 1px 0 rgb(255 255 255 / 0.25) inset;
      transition: transform 0.25s;
    }
    .mic:hover .mic-boton { transform: scale(1.06); }
    .mic-anillo {
      position: absolute; top: 0; width: 5.5rem; height: 5.5rem;
      border-radius: 9999px;
      border: 2px solid #b8944c;
      animation: respirar 2.8s ease-out infinite;
    }
    @keyframes respirar {
      from { transform: scale(1); opacity: 0.7; }
      to { transform: scale(1.7); opacity: 0; }
    }

    @media (prefers-reduced-motion: reduce) {
      .hero::before, .pulso::after, .mic-anillo { animation: none; }
    }
  </style>

  <script is:inline>
    (() => {
      // Conteo de los números al entrar (sin esto el valor final ya está en el HTML).
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        for (const el of document.querySelectorAll('[data-count]')) {
          const fin = Number(el.dataset.count);
          if (!fin) continue;
          const t0 = performance.now();
          const paso = (t) => {
            const p = Math.min(1, (t - t0) / 900);
            el.textContent = String(Math.round(fin * (1 - Math.pow(1 - p, 3))));
            if (p < 1) requestAnimationFrame(paso);
          };
          el.textContent = '0';
          requestAnimationFrame(paso);
        }
      }

      const lista = document.getElementById('lista');
      if (!lista) return;
      const buscar = document.getElementById('buscar');
      const vacio = document.getElementById('sin-resultados');
      const botones = [...document.querySelectorAll('#filtros button')];
      let filtro = 'todas';
      const aplicar = () => {
        const q = buscar.value.trim().toLowerCase();
        let visibles = 0;
        for (const li of lista.children) {
          const ok = (filtro === 'todas' || li.dataset.estado === filtro) && li.dataset.texto.includes(q);
          li.hidden = !ok;
          if (ok) visibles++;
        }
        vacio.classList.toggle('hidden', visibles > 0);
      };
      buscar.addEventListener('input', aplicar);
      for (const b of botones) {
        b.addEventListener('click', () => {
          filtro = b.dataset.filtro;
          for (const o of botones) o.setAttribute('aria-pressed', String(o === b));
          aplicar();
        });
      }
    })();
  </script>
</AdminLayout>
