---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import QuienesSomos from '../components/QuienesSomos.astro';
import Servicios from '../components/Servicios.astro';
import Faq from '../components/Faq.astro';
import Contacto from '../components/Contacto.astro';
import Schema from '../components/Schema.astro';
import ChatWidget from '../components/ChatWidget.tsx';
// Las sugerencias se resuelven en el server y viajan como prop serializada:
// el system prompt (agente.ts) nunca entra al bundle del cliente.
import { preguntasSugeridas } from '../data/agente';
---

{/*
  El title lleva marca + servicio + zona porque asi es como se busca una
  escribania ("escribania belgrano", no "escribania tocagni"). Apunta a
  "Belgrano y Nunez" porque la sede (Libertador 6328) esta en el limite de los
  dos barrios y la gente busca cualquiera de los dos.
*/}
<Layout
  title="Escribanía Tocagni — Escribana en Belgrano y Núñez, CABA"
  description="Escribanía en Belgrano y Núñez, CABA. Certificaciones, compraventa de inmuebles, sucesiones, sociedades y fideicomisos. Turnos por WhatsApp."
  image="/og.jpg"
>
  <main>
    <Hero />
    <QuienesSomos />
    <Servicios />
    <Faq />
    <Contacto />
  </main>

  <ChatWidget client:idle sugerencias={preguntasSugeridas} />
  <Schema />
</Layout>
